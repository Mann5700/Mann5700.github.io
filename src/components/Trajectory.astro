---
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import { durationLabel, formatRange } from '../lib/site';

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const education = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="trajectory" aria-labelledby="trajectory-title">
  <div class="shell">
    <SectionHeader
      index="02"
      id="trajectory-title"
      title="Trajectory"
      lede="Three roles, each one a step further from the interface and closer to the system underneath it."
    />

    <ol class="track" role="list">
      {
        roles.map((role, i) => (
          <li class="stop" data-reveal data-reveal-delay={i * 70}>
            <div class="stop__rail" aria-hidden="true">
              <span class:list={['stop__node', role.data.current && 'is-current']} />
              <span class="stop__line" />
            </div>

            <div class="stop__period">
              <span class="mono stop__dates">{formatRange(role.data.start, role.data.end, role.data.current)}</span>
              <span class="stop__duration">{durationLabel(role.data.start, role.data.current ? undefined : role.data.end)}</span>
              {role.data.location && <span class="stop__location">{role.data.location}</span>}
            </div>

            <div class="stop__body">
              <h3 class="stop__company">
                {role.data.href ? (
                  <a href={role.data.href} rel="noopener noreferrer" target="_blank">
                    {role.data.company}
                  </a>
                ) : (
                  role.data.company
                )}
              </h3>
              <p class="stop__role">{role.data.role}</p>
              <p class="stop__summary">{role.data.summary}</p>

              <details class="log" open={role.data.current}>
                <summary>
                  <span class="log__label">Mission log</span>
                  <span class="log__count mono">{String(role.data.highlights.length).padStart(2, '0')}</span>
                  <svg class="log__chev" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 6.5 8 10.5l4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <ul class="log__list" role="list">
                  {role.data.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </details>

              <ul class="chip-row stop__tech" role="list">
                {role.data.technologies.map((tech) => (
                  <li>
                    <span class="chip">{tech}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    {
      education.length > 0 && (
        <div class="foundations" data-reveal>
          <h3 class="label foundations__label">Foundations</h3>
          <ul class="foundations__list" role="list">
            {education.map((item) => (
              <li class="foundation">
                <span class="mono foundation__years">{formatRange(item.data.start, item.data.end)}</span>
                <span class="foundation__credential">
                  {item.data.credential}
                  {item.data.field && <span class="foundation__field">{item.data.field}</span>}
                </span>
                <span class="foundation__school">
                  {item.data.institution}
                  {item.data.distinction && <em class="foundation__distinction">{item.data.distinction}</em>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .track {
    display: grid;
    gap: var(--sp-2xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stop {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0 var(--sp-m);
  }

  /* ------------------------------------------------------------------ rail */

  .stop__rail {
    position: relative;
    grid-column: 1;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block-start: 0.45rem;
  }

  .stop__period {
    grid-column: 2;
    grid-row: 1;
  }

  .stop__body {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
  }

  .stop__node {
    position: relative;
    width: 10px;
    height: 10px;
    border: 1px solid rgb(255 255 255 / 34%);
    border-radius: 50%;
    background: var(--c-void);
    flex: none;
    transition: border-color var(--d-base) var(--e-out), box-shadow var(--d-base) var(--e-out);
  }

  .stop:hover .stop__node {
    border-color: var(--c-muted);
  }

  .stop__node.is-current {
    border-color: var(--c-ember);
    background: var(--c-ember);
    box-shadow: 0 0 0 4px rgb(255 157 92 / 12%);
  }

  .stop__node.is-current::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1px solid var(--c-ember);
    border-radius: 50%;
    animation: orbit-pulse calc(3s / max(var(--motion), 0.001)) var(--e-out) infinite;
  }

  @keyframes orbit-pulse {
    0% {
      opacity: 0.7;
      transform: scale(0.7);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  .stop__line {
    flex: 1;
    width: 1px;
    margin-block-start: 0.45rem;
    background-image: repeating-linear-gradient(
      180deg,
      rgb(255 255 255 / 30%) 0 3px,
      transparent 3px 9px
    );
    -webkit-mask-image: linear-gradient(180deg, #000 0 72%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0 72%, transparent 100%);
    transform-origin: 50% 0;
  }

  /* Where supported, the connecting line draws itself as the entry scrolls in.
     Elsewhere it is simply already drawn. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stop__line {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 8% cover 42%;
      }

      @keyframes draw {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }
    }
  }

  .stop:last-child .stop__line {
    -webkit-mask-image: linear-gradient(180deg, #000 0 30%, transparent 92%);
    mask-image: linear-gradient(180deg, #000 0 30%, transparent 92%);
  }

  /* ---------------------------------------------------------------- period */

  .stop__period {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
    margin-block-end: var(--sp-s);
  }

  .stop__dates {
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .stop__duration,
  .stop__location {
    font-size: var(--step--2);
    color: var(--c-dim);
  }

  /* ------------------------------------------------------------------ body */

  .stop__company {
    font-size: var(--step-4);
    font-weight: 300;
    letter-spacing: var(--ls-display);
    color: var(--c-text-strong);
  }

  .stop__company a {
    border-block-end: 1px solid transparent;
    transition: border-color var(--d-base) var(--e-out);
  }

  .stop__company a:hover {
    border-block-end-color: var(--c-line-strong);
  }

  .stop__role {
    margin-block-start: 0.2rem;
    font-family: var(--f-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--c-ember);
  }

  .stop__summary {
    max-width: 52ch;
    margin-block-start: var(--sp-s);
    color: var(--c-muted);
    font-weight: 300;
  }

  /* ------------------------------------------------------------------- log */

  .log {
    margin-block-start: var(--sp-m);
    border-block-start: 1px solid var(--c-line);
  }

  .log summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.85rem;
    cursor: pointer;
    list-style: none;
    color: var(--c-muted);
    transition: color var(--d-base) var(--e-out);
  }

  .log summary::-webkit-details-marker {
    display: none;
  }

  .log summary:hover {
    color: var(--c-text);
  }

  .log__label {
    font-family: var(--f-mono);
    font-size: var(--step--2);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }

  .log__count {
    font-size: var(--step--2);
    color: var(--c-dim);
  }

  .log__chev {
    width: 1rem;
    height: 1rem;
    margin-inline-start: auto;
    transition: transform var(--d-base) var(--e-out);
  }

  .log[open] .log__chev {
    transform: rotate(180deg);
  }

  .log__list {
    display: grid;
    gap: 0.85rem;
    margin: 0 0 var(--sp-s);
    padding: 0;
    list-style: none;
  }

  .log__list li {
    position: relative;
    padding-inline-start: 1.35rem;
    max-width: 68ch;
    font-size: var(--step--1);
    line-height: 1.62;
    color: var(--c-muted);
  }

  .log__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--c-ember);
    opacity: 0.8;
  }

  /* Height animation where the browser supports it; instant elsewhere. */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .log::details-content {
        block-size: 0;
        overflow: clip;
        transition:
          block-size var(--d-base) var(--e-out),
          content-visibility var(--d-base) allow-discrete;
      }

      .log[open]::details-content {
        block-size: auto;
      }
    }
  }

  .stop__tech {
    margin-block-start: var(--sp-m);
  }

  /* ----------------------------------------------------------- foundations */

  .foundations {
    margin-block-start: var(--sp-3xl);
    padding-block-start: var(--sp-l);
    border-block-start: 1px solid var(--c-line);
  }

  .foundations__label {
    margin-block-end: var(--sp-m);
  }

  .foundations__list {
    display: grid;
    gap: var(--sp-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foundation {
    display: grid;
    gap: 0.25rem;
  }

  .foundation__years {
    font-size: var(--step--2);
    color: var(--c-dim);
  }

  .foundation__credential {
    font-family: var(--f-display);
    font-size: var(--step-1);
    font-weight: 300;
    color: var(--c-text);
  }

  .foundation__field {
    color: var(--c-muted);
  }

  .foundation__field::before {
    content: ', ';
  }

  .foundation__school {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: var(--step--1);
    color: var(--c-faint);
  }

  .foundation__distinction {
    font-style: normal;
    color: var(--c-ion);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    align-self: center;
  }

  /* ----------------------------------------------------------- breakpoints */

  @media (min-width: 60rem) {
    .track {
      gap: var(--sp-3xl);
    }

    .stop {
      grid-template-columns: minmax(9rem, 12rem) 1.25rem minmax(0, 1fr);
      gap: 0 var(--sp-l);
    }

    .stop__rail {
      grid-column: 2;
      grid-row: 1 / -1;
    }

    .stop__period {
      grid-column: 1;
      grid-row: 1;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
      padding-block-start: 0.35rem;
      text-align: left;
      margin-block-end: 0;
    }

    .stop__body {
      grid-column: 3;
      grid-row: 1;
    }

    .foundations__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-l);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stop__node.is-current::after {
      animation: none;
    }
  }
</style>
