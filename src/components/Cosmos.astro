---
/**
 * The persistent deep-space environment. Ships a static CSS composition first;
 * the WebGL renderer replaces it when the device can afford one.
 */
interface Props {
  /** Sub-pages keep the starfield but push the black hole out of frame. */
  ambient?: boolean;
}
const { ambient = false } = Astro.props;
---

<div
  class="cosmos"
  aria-hidden="true"
  data-cosmos-host
  data-ambient={ambient ? 'true' : undefined}
>
</div>

<style>
  .cosmos {
    position: fixed;
    inset: 0;
    z-index: var(--z-bg);
    pointer-events: none;
    overflow: hidden;
    background-color: var(--c-void);
    background-image:
      /* hot core */
      radial-gradient(
        circle at var(--neb-x, 70%) var(--neb-y, 46%),
        rgb(255 228 190 / 34%) 0,
        rgb(255 150 90 / 18%) 9vmin,
        transparent 20vmin
      ),
      /* warm filaments */
        radial-gradient(
          ellipse 34vmin 26vmin at calc(var(--neb-x, 70%) - 6vmin) calc(var(--neb-y, 46%) + 4vmin),
          rgb(232 92 48 / 44%),
          transparent 72%
        ),
      /* teal oxygen shell */
        radial-gradient(
          ellipse 40vmin 30vmin at calc(var(--neb-x, 70%) + 7vmin) calc(var(--neb-y, 46%) - 5vmin),
          rgb(28 160 195 / 44%),
          transparent 70%
        ),
      /* violet outskirts */
        radial-gradient(
          ellipse 52vmin 40vmin at var(--neb-x, 70%) var(--neb-y, 46%),
          rgb(120 60 165 / 32%),
          transparent 72%
        ),
      /* cold dust */
        radial-gradient(60% 50% at 18% 80%, rgb(48 70 110 / 14%), transparent 70%),
      /* starfield tile */
        url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%27420%27 height=%27420%27%3E%3Cg fill=%27%23ffffff%27%3E%3Ccircle cx=%2734%27 cy=%2751%27 r=%271%27 opacity=%27.55%27/%3E%3Ccircle cx=%27118%27 cy=%2719%27 r=%27.7%27 opacity=%27.35%27/%3E%3Ccircle cx=%27201%27 cy=%2788%27 r=%271.2%27 opacity=%27.6%27/%3E%3Ccircle cx=%27288%27 cy=%2734%27 r=%27.6%27 opacity=%27.3%27/%3E%3Ccircle cx=%27376%27 cy=%27102%27 r=%271%27 opacity=%27.45%27/%3E%3Ccircle cx=%2762%27 cy=%27158%27 r=%27.8%27 opacity=%27.4%27/%3E%3Ccircle cx=%27154%27 cy=%27211%27 r=%271.1%27 opacity=%27.5%27/%3E%3Ccircle cx=%27243%27 cy=%27172%27 r=%27.6%27 opacity=%27.3%27/%3E%3Ccircle cx=%27330%27 cy=%27236%27 r=%27.9%27 opacity=%27.42%27/%3E%3Ccircle cx=%2716%27 cy=%27268%27 r=%271%27 opacity=%27.5%27/%3E%3Ccircle cx=%27100%27 cy=%27327%27 r=%27.7%27 opacity=%27.32%27/%3E%3Ccircle cx=%27196%27 cy=%27299%27 r=%271.3%27 opacity=%27.58%27/%3E%3Ccircle cx=%27284%27 cy=%27366%27 r=%27.8%27 opacity=%27.38%27/%3E%3Ccircle cx=%27366%27 cy=%27312%27 r=%27.6%27 opacity=%27.28%27/%3E%3Ccircle cx=%27128%27 cy=%27122%27 r=%27.5%27 opacity=%27.25%27/%3E%3Ccircle cx=%27222%27 cy=%2764%27 r=%27.5%27 opacity=%27.22%27/%3E%3C/g%3E%3C/svg%3E');
    background-repeat: no-repeat, no-repeat, no-repeat, no-repeat, no-repeat, repeat;
    background-size: auto, auto, auto, auto, auto, 420px 420px;
  }

  .cosmos::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 50%, transparent 35%, rgb(5 6 10 / 72%) 100%);
  }

  .cosmos :global(.cosmos__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The shader draws its own vignette. */
  .cosmos[data-cosmos='live']::after {
    display: none;
  }

  @media (max-aspect-ratio: 1/1) {
    .cosmos {
      --neb-x: 50%;
      --neb-y: 18%;
    }
  }

  .cosmos[data-ambient] {
    --neb-y: -30%;
    opacity: 0.6;
  }
</style>

<script>
  import { mountCosmos } from '../scripts/cosmos';

  const host = document.querySelector<HTMLElement>('[data-cosmos-host]');
  if (host) mountCosmos(host);
</script>
