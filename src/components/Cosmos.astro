---
/**
 * The persistent deep-space environment.
 *
 * A star field and dust rendered in CSS paint instantly; the Hubble plate of
 * the Crab Nebula sits over them. The plate carries no entrance animation on
 * purpose — anything that starts at zero opacity stays invisible wherever the
 * animation timeline is frozen, such as a tab that loads in the background.
 *
 * Plate: NASA, ESA, J. Hester and A. Loll (Arizona State University).
 */
import { url } from '../lib/site';

interface Props {
  /** Sub-pages get the environment without the subject front and centre. */
  ambient?: boolean;
}
const { ambient = false } = Astro.props;

const WIDTHS = [480, 720, 1024, 1440, 1920, 2560];
const srcset = (ext: string) =>
  WIDTHS.map((w) => `${url(`/images/nebula/crab-${w}.${ext}`)} ${w}w`).join(', ');

/* Matches the CSS below: the plate is square and sized to sit wholly inside
   the viewport, so the remnant is never clipped by an edge. */
const sizes = '(max-aspect-ratio: 1/1) min(74vw, 32vh), min(55vw, 86vh)';
---

<div
  class="cosmos"
  aria-hidden="true"
  data-cosmos-host
  data-ambient={ambient ? 'true' : undefined}
>
  <picture class="cosmos__plate">
    <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
    <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
    <img
      class="cosmos__img"
      src={url('/images/nebula/crab-1024.webp')}
      alt=""
      width="3864"
      height="3864"
      decoding="async"
      fetchpriority="low"
    />
  </picture>

  <div class="cosmos__grade"></div>
</div>

<style>
  .cosmos {
    position: fixed;
    inset: 0;
    z-index: var(--z-bg);
    pointer-events: none;
    overflow: hidden;
    background-color: var(--c-void);
    /* Star field and cold dust, painted immediately so the first frame is
       never an empty rectangle. */
    background-image:
      radial-gradient(60% 50% at 16% 82%, rgb(48 70 110 / 16%), transparent 70%),
      radial-gradient(45% 40% at 88% 14%, rgb(74 52 118 / 14%), transparent 70%),
      url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%27420%27 height=%27420%27%3E%3Cg fill=%27%23ffffff%27%3E%3Ccircle cx=%2734%27 cy=%2751%27 r=%271%27 opacity=%27.55%27/%3E%3Ccircle cx=%27118%27 cy=%2719%27 r=%27.7%27 opacity=%27.35%27/%3E%3Ccircle cx=%27201%27 cy=%2788%27 r=%271.2%27 opacity=%27.6%27/%3E%3Ccircle cx=%27288%27 cy=%2734%27 r=%27.6%27 opacity=%27.3%27/%3E%3Ccircle cx=%27376%27 cy=%27102%27 r=%271%27 opacity=%27.45%27/%3E%3Ccircle cx=%2762%27 cy=%27158%27 r=%27.8%27 opacity=%27.4%27/%3E%3Ccircle cx=%27154%27 cy=%27211%27 r=%271.1%27 opacity=%27.5%27/%3E%3Ccircle cx=%27243%27 cy=%27172%27 r=%27.6%27 opacity=%27.3%27/%3E%3Ccircle cx=%27330%27 cy=%27236%27 r=%27.9%27 opacity=%27.42%27/%3E%3Ccircle cx=%2716%27 cy=%27268%27 r=%271%27 opacity=%27.5%27/%3E%3Ccircle cx=%27100%27 cy=%27327%27 r=%27.7%27 opacity=%27.32%27/%3E%3Ccircle cx=%27196%27 cy=%27299%27 r=%271.3%27 opacity=%27.58%27/%3E%3Ccircle cx=%27284%27 cy=%27366%27 r=%27.8%27 opacity=%27.38%27/%3E%3Ccircle cx=%27366%27 cy=%27312%27 r=%27.6%27 opacity=%27.28%27/%3E%3Ccircle cx=%27128%27 cy=%27122%27 r=%27.5%27 opacity=%27.25%27/%3E%3Ccircle cx=%27222%27 cy=%2764%27 r=%27.5%27 opacity=%27.22%27/%3E%3C/g%3E%3C/svg%3E');
    background-repeat: no-repeat, no-repeat, repeat;
    background-size: auto, auto, 420px 420px;
  }

  /* ------------------------------------------------------------------ plate */

  .cosmos__plate {
    position: absolute;
    top: 50%;
    right: 1vw;
    display: block;
    width: min(55vw, 86vh);
    aspect-ratio: 1;
    translate: 0 -50%;
    transform: translate3d(var(--px, 0px), calc(var(--py, 0px) + var(--drift, 0px)), 0);
    opacity: var(--dim, 1);
    /* The plate's own background is black, so screen-blending dissolves it
       into the page and leaves only the gas and its stars. */
    mix-blend-mode: screen;
    /* Fades only the square's corners. The inscribed circle stays opaque, so
       no part of the remnant itself is masked away. */
    -webkit-mask-image: radial-gradient(
      circle,
      #000 0 71%,
      rgb(0 0 0 / 50%) 85%,
      transparent 99%
    );
    mask-image: radial-gradient(circle, #000 0 71%, rgb(0 0 0 / 50%) 85%, transparent 99%);
    will-change: transform;
  }

  .cosmos__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --------------------------------------------------------------- grading */

  .cosmos__grade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(5 6 10 / 84%) 0%,
        rgb(5 6 10 / 56%) 40%,
        rgb(5 6 10 / 0%) 70%
      ),
      radial-gradient(130% 95% at 50% 50%, transparent 38%, rgb(5 6 10 / 62%) 100%);
  }

  /* Screen blending keeps bright gas legible through low opacity alone, so the
     whole field is also scrimmed as the page scrolls away from the hero. */
  .cosmos__grade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c-void);
    opacity: calc((1 - var(--dim, 1)) * 0.62);
  }

  /* ----------------------------------------------------------- breakpoints */

  @media (max-aspect-ratio: 1/1) {
    .cosmos__plate {
      top: 4rem;
      right: auto;
      left: 50%;
      /* Height-bound as well as width-bound, so the plate still clears the
         hero's reserved band on a portrait tablet. */
      width: min(74vw, 32svh);
      translate: -50% 0;
    }

    /* Keeps the band the hero reserves bright, then ramps hard into darkness
       so the headline below always has contrast. */
    .cosmos__grade {
      background:
        linear-gradient(
          180deg,
          rgb(5 6 10 / 62%) 0%,
          rgb(5 6 10 / 6%) 17%,
          rgb(5 6 10 / 28%) 33%,
          rgb(5 6 10 / 80%) 55%,
          rgb(5 6 10 / 95%) 100%
        ),
        radial-gradient(130% 62% at 50% 16%, transparent 46%, rgb(5 6 10 / 50%) 100%);
    }
  }

  .cosmos[data-ambient] .cosmos__plate {
    opacity: calc(var(--dim, 1) * 0.42);
    translate: 0 -76%;
  }

  @media (prefers-reduced-motion: reduce) {
    .cosmos__plate {
      transform: none;
    }
  }
</style>

<script>
  import { mountBackdrop } from '../scripts/backdrop';

  const host = document.querySelector<HTMLElement>('[data-cosmos-host]');
  if (host) mountBackdrop(host);
</script>
