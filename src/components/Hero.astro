---
import { getCollection, getEntry } from 'astro:content';
import { url } from '../lib/site';

const profile = (await getEntry('profile', 'profile'))!.data;
const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const currentRole = roles.find((role) => role.data.current) ?? roles[0];

const actions = [
  { label: 'View the work', href: url('/#missions'), primary: true },
  { label: 'Career trajectory', href: url('/#trajectory'), primary: false },
];
---

<section class="hero" id="origin" aria-labelledby="hero-name">
  <div class="shell shell--wide hero__inner">
    <p class="hero__eyebrow">
      <span class="mono hero__coord">01 / Origin</span>
      {
        profile.availability && (
          <span class="hero__status">
            <span class="hero__pulse" aria-hidden="true" />
            {profile.availability}
          </span>
        )
      }
    </p>

    <h1 class="hero__name" id="hero-name">
      {
        profile.name.split(' ').map((word, i, all) => (
          <span
            class:list={['hero__word', i === all.length - 1 && 'hero__word--lit']}
            style={`--i:${i}`}
          >
            {word}
          </span>
        ))
      }
    </h1>

    <p class="hero__role">
      <span>{profile.role}</span>
      {currentRole && <span class="hero__dot" aria-hidden="true" />}
      {currentRole && <span>{currentRole.data.company}</span>}
      <span class="hero__dot" aria-hidden="true"></span>
      <span class="hero__place">{profile.location}</span>
    </p>

    <p class="hero__headline">{profile.headline}</p>

    <div class="hero__actions">
      {
        actions.map((action) => (
          <a
            class:list={['btn', action.primary ? 'btn--primary' : '']}
            href={action.href}
            data-magnetic
          >
            {action.label}
            {action.primary && (
              <svg class="btn__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M3 8h10M9 4l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </a>
        ))
      }
      <a
        class="hero__inline"
        href={url(profile.resume.href)}
        target="_blank"
        rel="noopener"
        data-resume-open
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M1.7 8S3.9 4.2 8 4.2 14.3 8 14.3 8 12.1 11.8 8 11.8 1.7 8 1.7 8Z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="8" cy="8" r="1.9" stroke="currentColor" stroke-width="1.4"></circle>
        </svg>
        View {profile.resume.label.toLowerCase()}
      </a>
    </div>
  </div>

  {
    profile.metrics.length > 0 && (
      <div class="shell shell--wide">
        <dl class="hero__metrics">
          {profile.metrics.map((metric, i) => (
            <div class="metric" style={`--i:${i}`}>
              <dt class="metric__label">{metric.label}</dt>
              <dd class="metric__value">{metric.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  <a class="hero__scroll" href={url('/#trajectory')} aria-label="Scroll to career trajectory">
    <span class="mono">Scroll</span>
    <span class="hero__scroll-track" aria-hidden="true"><span></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    /* The top band is reserved for the backdrop subject on portrait viewports. */
    padding-block: calc(var(--nav-h) + 16.5rem) var(--sp-l);
    z-index: var(--z-content);
    overflow: clip;
  }

  /* Guarantees headline contrast whatever the background is doing behind it. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(5 6 10 / 30%) 12%, rgb(5 6 10 / 88%) 48%, rgb(5 6 10 / 95%));
    pointer-events: none;
  }

  .hero__inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Every hero element rises in on load with a shared cadence. This is a pure
     CSS animation so it runs even when the bundle fails to load. */
  .hero__eyebrow,
  .hero__name .hero__word,
  .hero__role,
  .hero__headline,
  .hero__actions,
  .metric,
  .hero__scroll {
    animation: rise 1.1s var(--e-out) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translate3d(0, 1.1rem, 0);
    }
  }

  /* -------------------------------------------------------------- eyebrow */

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-s) var(--sp-m);
    margin-block-end: var(--sp-m);
    animation-delay: 0.05s;
  }

  .hero__coord {
    font-size: var(--step--2);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-faint);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.28rem 0.75rem 0.28rem 0.6rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 3%);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    color: var(--c-muted);
  }

  .hero__pulse {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-ember);
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--c-ember);
    animation: pulse calc(2.6s / max(var(--motion), 0.001)) var(--e-out) infinite;
  }

  @keyframes pulse {
    0% {
      opacity: 0.85;
      transform: scale(0.6);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(2.1);
    }
  }

  /* ------------------------------------------------------------------ name */

  .hero__name {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
    margin-block-end: var(--sp-m);
    font-size: var(--step-7);
    font-weight: 200;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-mega);
    color: var(--c-text-strong);
    /* Light in vacuum: a cold bloom, plus a tight dark halo that holds contrast
       wherever the plate is bright behind the type. */
    text-shadow: 0 0 90px rgb(159 217 255 / 18%), 0 0 26px rgb(5 6 10 / 55%);
  }

  .hero__word {
    display: block;
    animation-delay: calc(0.12s + var(--i) * 0.09s);
  }

  /* The surname is filled with the remnant's own palette instead of a flat
     colour. The fill drifts like gas and a specular band crosses it slowly.
     Both layers move in one animation because they share background-position. */
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    /* Scoped through .hero__name to outrank the shared `rise` rule, which would
       otherwise drop the second animation from the shorthand. */
    .hero__name .hero__word--lit {
      background-image:
        linear-gradient(100deg, transparent 41%, rgb(255 255 255 / 72%) 50%, transparent 59%),
        linear-gradient(
          92deg,
          #9fd9ff 0%,
          #eaf7ff 13%,
          #ffdcae 36%,
          #ff9d5c 55%,
          #c79bf5 77%,
          #9fd9ff 100%
        );
      background-size: 260% 100%, 200% 100%;
      background-repeat: no-repeat;
      background-position: -130% 0, 0 0;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      animation:
        rise 1.1s var(--e-out) both,
        nebula-text 16s linear infinite;
      animation-delay: calc(0.12s + var(--i) * 0.09s), 0s;
    }
  }

  @keyframes nebula-text {
    0% {
      background-position: -130% 0, 0% 0;
    }
    35% {
      background-position: 230% 0, 70% 0;
    }
    100% {
      background-position: 230% 0, 200% 0;
    }
  }

  /* Parallax depth. `--ptr-x/y` are published by the backdrop script and default
     to 0, so this is inert without a mouse or without JavaScript. Foreground
     layers move against the plate, which is what sells the separation. */
  .hero__eyebrow,
  .hero__name,
  .hero__role,
  .hero__headline,
  .hero__actions {
    translate: calc(var(--ptr-x, 0) * var(--depth, 0px) * -1)
      calc(var(--ptr-y, 0) * var(--depth, 0px) * -1);
  }

  .hero__eyebrow {
    --depth: 5px;
  }
  .hero__name {
    --depth: 15px;
  }
  .hero__role {
    --depth: 10px;
  }
  .hero__headline {
    --depth: 7px;
  }
  .hero__actions {
    --depth: 4px;
  }

  /* The hero recedes as it leaves frame, where the browser can drive an
     animation from scroll position. Elsewhere this simply never applies. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__inner {
        animation: hero-depart linear both;
        animation-timeline: view();
        animation-range: exit 5% exit 95%;
      }

      @keyframes hero-depart {
        to {
          opacity: 0.18;
          translate: 0 -4vh;
        }
      }
    }
  }

  /* ------------------------------------------------------------------ role */

  .hero__role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.85rem;
    margin-block-end: var(--sp-l);
    font-family: var(--f-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
    animation-delay: 0.34s;
  }

  .hero__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--c-dim);
  }

  .hero__place {
    color: var(--c-faint);
  }

  /* -------------------------------------------------------------- headline */

  .hero__headline {
    max-width: 30ch;
    margin-block-end: var(--sp-xl);
    font-family: var(--f-display);
    font-size: var(--step-2);
    font-weight: 300;
    line-height: 1.38;
    letter-spacing: var(--ls-heading);
    color: var(--c-text);
    text-wrap: balance;
    animation-delay: 0.42s;
  }

  /* --------------------------------------------------------------- actions */

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-s) var(--sp-m);
    animation-delay: 0.5s;
  }

  .hero__inline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.35rem;
    font-size: var(--step--1);
    color: var(--c-muted);
    border-block-end: 1px solid transparent;
    transition: color var(--d-base) var(--e-out), border-color var(--d-base) var(--e-out);
  }

  .hero__inline svg {
    width: 1em;
    height: 1em;
  }

  .hero__inline:hover {
    color: var(--c-text);
    border-block-end-color: var(--c-line-strong);
  }

  /* --------------------------------------------------------------- metrics */

  .hero__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-block-start: var(--sp-xl);
    background: var(--c-line);
    border-block: 1px solid var(--c-line);
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    padding: var(--sp-m) var(--sp-s);
    background: var(--c-void);
    animation-delay: calc(0.62s + var(--i) * 0.07s);
  }

  .metric__value {
    margin: 0;
    font-family: var(--f-display);
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1;
    letter-spacing: var(--ls-display);
    color: var(--c-text-strong);
    font-variant-numeric: tabular-nums;
  }

  .metric__label {
    font-size: var(--step--2);
    line-height: 1.4;
    color: var(--c-faint);
    text-wrap: pretty;
  }

  /* ---------------------------------------------------------------- scroll */

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: calc(var(--sp-xl) + 1rem);
    display: none;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step--2);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-dim);
    writing-mode: vertical-rl;
    animation-delay: 1s;
    transition: color var(--d-base) var(--e-out);
  }

  .hero__scroll:hover {
    color: var(--c-muted);
  }

  .hero__scroll-track {
    position: relative;
    display: block;
    width: 1px;
    height: 3.5rem;
    background: var(--c-line-strong);
    overflow: hidden;
  }

  .hero__scroll-track span {
    position: absolute;
    inset-inline: 0;
    height: 40%;
    background: var(--c-ember);
    animation: trickle calc(2.4s / max(var(--motion), 0.001)) var(--e-in-out) infinite;
  }

  @keyframes trickle {
    0% {
      transform: translateY(-110%);
    }
    100% {
      transform: translateY(260%);
    }
  }

  /* ----------------------------------------------------------- breakpoints */

  @media (min-width: 48rem) {
    .hero__metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .metric {
      padding: var(--sp-m) var(--sp-m);
    }
  }

  @media (min-width: 60rem) {
    .hero {
      padding-block: calc(var(--nav-h) + var(--sp-3xl)) var(--sp-xl);
    }

    .hero__metrics {
      margin-block-start: var(--sp-3xl);
    }

    .hero__headline {
      max-width: 26ch;
      font-size: var(--step-3);
    }

    .hero__scroll {
      display: flex;
    }
  }

  @media (min-aspect-ratio: 1/1) {
    .hero::before {
      background: linear-gradient(95deg, rgb(5 6 10 / 88%) 18%, rgb(5 6 10 / 45%) 52%, transparent 78%);
    }

    .hero__inner {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__name .hero__word,
    .hero__role,
    .hero__headline,
    .hero__actions,
    .metric,
    .hero__scroll,
    .hero__pulse::after,
    .hero__scroll-track span {
      animation: none;
    }

    /* The nebula fill stays; only its drift stops. */
    .hero__eyebrow,
    .hero__name,
    .hero__role,
    .hero__headline,
    .hero__actions {
      translate: none;
    }
  }
</style>
